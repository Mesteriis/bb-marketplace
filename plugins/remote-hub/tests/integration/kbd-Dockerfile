# Throwaway keyboard-interactive-only SSH server for the Remote Hub askpass tests (paramiko).
FROM alpine:3.20@sha256:d9e853e87e55526f6b2917df91a2115c36dd7c696a35be12163d44e6e2a4b6bc
RUN apk add --no-cache python3 py3-paramiko
COPY kbd-server.py /kbd-server.py
EXPOSE 2222
CMD ["python3", "-u", "/kbd-server.py"]
