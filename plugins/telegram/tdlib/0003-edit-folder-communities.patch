+void DialogFilterManager::set_makosh_chat_folder_community(
+    DialogFilterId dialog_filter_id, CommunityId community_id, bool expected_included, bool included,
+    Promise<td_api::object_ptr<td_api::makoshChatFolderCommunityChange>> &&promise) {
+  const auto *old_filter = get_dialog_filter(dialog_filter_id);
+  if (old_filter == nullptr) {
+    return promise.set_error(400, "Chat folder not found");
+  }
+  auto community = td_->community_manager_->get_community_object(community_id);
+  auto dialog_id = community_id.get_fake_dialog_id();
+  if (community == nullptr || !community->have_access_ || !DialogFilter::is_community_dialog_id(dialog_id)
+      || community->status_->get_id() == td_api::communityMemberStatusLeft::ID
+      || community->status_->get_id() == td_api::communityMemberStatusBanned::ID) {
+    return promise.set_error(400, "Community unavailable");
+  }
+  if (old_filter->is_dialog_included(dialog_id) != expected_included) {
+    return promise.set_value(td_api::make_object<td_api::makoshChatFolderCommunityChange>(false));
+  }
+  if (expected_included == included) {
+    return promise.set_value(td_api::make_object<td_api::makoshChatFolderCommunityChange>(true));
+  }
+
+  auto new_filter = make_unique<DialogFilter>(*old_filter);
+  if (included) {
+    if (!community->are_chats_collapsed_) {
+      return promise.set_error(400, "Only collapsed communities can be added to folders");
+    }
+    auto peer = td_->community_manager_->get_input_peer(community_id);
+    if (peer == nullptr) {
+      return promise.set_error(400, "Community unavailable");
+    }
+    new_filter->include_dialog(InputDialogId(peer));
+  } else {
+    new_filter->remove_dialog_id(dialog_id);
+  }
+  TRY_STATUS_PROMISE(promise, new_filter->check_limits());
+  new_filter->sort_input_dialog_ids(td_, "set_makosh_chat_folder_community");
+  do_edit_dialog_filter(std::move(new_filter), true, "set_makosh_chat_folder_community");
+  promise.set_value(td_api::make_object<td_api::makoshChatFolderCommunityChange>(true));
+}
