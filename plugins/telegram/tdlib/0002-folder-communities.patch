+td_api::object_ptr<td_api::makoshChatFolderCommunities> DialogFilter::get_makosh_chat_folder_communities() const {
+  vector<int64> community_ids;
+  vector<td_api::object_ptr<td_api::makoshChatFolderPinnedPeer>> pinned_peers;
+  for (const auto &input_peer : pinned_dialog_ids_) {
+    const auto peer = input_peer.get_dialog_id();
+    const bool is_community = is_community_dialog_id(peer);
+    if (is_community && InputDialogId::contains(excluded_dialog_ids_, peer)) {
+      continue;
+    }
+    const auto id = is_community ? peer.get_channel_id().get() : peer.get();
+    pinned_peers.push_back(td_api::make_object<td_api::makoshChatFolderPinnedPeer>(id, is_community));
+    if (is_community) {
+      community_ids.push_back(id);
+    }
+  }
+  for (const auto &input_peer : included_dialog_ids_) {
+    const auto peer = input_peer.get_dialog_id();
+    if (is_community_dialog_id(peer) && !InputDialogId::contains(excluded_dialog_ids_, peer)) {
+      community_ids.push_back(peer.get_channel_id().get());
+    }
+  }
+  return td_api::make_object<td_api::makoshChatFolderCommunities>(std::move(community_ids), std::move(pinned_peers));
+}
