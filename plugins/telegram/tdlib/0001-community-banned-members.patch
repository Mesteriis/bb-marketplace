+class GetMakoshCommunityBannedMembersQuery final : public Td::ResultHandler {
+  Promise<td_api::object_ptr<td_api::makoshCommunityBannedMembers>> promise_;
+  int32 offset_ = 0;
+  int32 limit_ = 0;
+
+ public:
+  explicit GetMakoshCommunityBannedMembersQuery(
+      Promise<td_api::object_ptr<td_api::makoshCommunityBannedMembers>> &&promise)
+      : promise_(std::move(promise)) {
+  }
+
+  void send(telegram_api::object_ptr<telegram_api::InputChannel> input_community, int32 offset, int32 limit) {
+    offset_ = offset;
+    limit_ = limit;
+    send_query(G()->net_query_creator().create(telegram_api::channels_getParticipants(
+        std::move(input_community), telegram_api::make_object<telegram_api::channelParticipantsKicked>(string()),
+        offset, limit, 0)));
+  }
+
+  void on_result(BufferSlice packet) final {
+    auto result = fetch_result<telegram_api::channels_getParticipants>(packet);
+    if (result.is_error()) {
+      return on_error(result.move_as_error());
+    }
+    auto response = result.move_as_ok();
+    if (response->get_id() != telegram_api::channels_channelParticipants::ID) {
+      return on_error(Status::Error(500, "Unexpected community participants response"));
+    }
+    auto page = telegram_api::move_object_as<telegram_api::channels_channelParticipants>(response);
+    if (page->participants_.size() > static_cast<size_t>(limit_)) {
+      return on_error(Status::Error(500, "Invalid community participants page size"));
+    }
+    const auto total_count = max(0, page->count_);
+    const auto consumed = offset_ + static_cast<int32>(page->participants_.size());
+    const auto next_offset =
+        !page->participants_.empty() && consumed <= std::numeric_limits<int32>::max() - limit_ ? consumed : -1;
+    td_->user_manager_->on_get_users(std::move(page->users_), "GetMakoshCommunityBannedMembersQuery");
+    td_->chat_manager_->on_get_chats(std::move(page->chats_), "GetMakoshCommunityBannedMembersQuery");
+
+    vector<td_api::object_ptr<td_api::chatMember>> members;
+    members.reserve(page->participants_.size());
+    for (auto &entry : page->participants_) {
+      DialogParticipant participant(std::move(entry), ChannelType::Megagroup);
+      if (participant.is_valid() && participant.status_.is_banned()) {
+        members.push_back(td_->chat_manager_->get_chat_member_object(participant, "GetMakoshCommunityBannedMembersQuery"));
+      }
+    }
+    promise_.set_value(
+        td_api::make_object<td_api::makoshCommunityBannedMembers>(total_count, std::move(members), next_offset));
+  }
+
+  void on_error(Status status) final {
+    promise_.set_error(std::move(status));
+  }
+};
