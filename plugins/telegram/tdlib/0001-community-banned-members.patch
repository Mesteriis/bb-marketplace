+void CommunityManager::get_makosh_community_banned_members(
+    CommunityId community_id, int32 offset, int32 limit,
+    Promise<td_api::object_ptr<td_api::makoshCommunityBannedMembers>> &&promise) {
+  if (offset < 0 || limit < 1 || limit > 100 || offset > std::numeric_limits<int32>::max() - limit) {
+    return promise.set_error(400, "Invalid banned members page");
+  }
+  auto input_community = get_input_community(community_id);
+  if (input_community == nullptr) {
+    return promise.set_error(400, "Community not found");
+  }
+  if (!get_community_status(community_id).is_administrator()) {
+    return promise.set_error(403, "Community administrator rights required");
+  }
+  td_->create_handler<GetMakoshCommunityBannedMembersQuery>(std::move(promise))
+      ->send(std::move(input_community), offset, limit);
+}
