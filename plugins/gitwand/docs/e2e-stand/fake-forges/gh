#!/bin/sh
# Stand stand-in for gh: two made-up accounts, their repositories, and a check
# that each listing arrives with that account's own token and nothing else.
D=$(dirname "$0")/data
LOG=${FAKE_FORGE_LOG:-/dev/null}
case "$1 $2" in
"auth status") cat "$D/gh-auth.json"; exit 0 ;;
"auth token") printf 'fake-token-%s\n' "$6"; exit 0 ;;
"api --hostname")
  if [ -n "${GITHUB_TOKEN:-}" ] || [ -n "${GH_ENTERPRISE_TOKEN:-}" ]; then echo "gh api: GITHUB_TOKEN leaked" >>"$LOG"; exit 3; fi
  case "${GH_TOKEN:-}" in
  fake-token-stand-owner) echo "gh api stand-owner" >>"$LOG"; cat "$D/gh-stand-owner.ndjson" ;;
  fake-token-stand-work) echo "gh api stand-work" >>"$LOG"; cat "$D/gh-stand-work.ndjson" ;;
  *) echo "HTTP 401: Bad credentials ${GH_TOKEN:-none}" >&2; exit 1 ;;
  esac
  exit 0 ;;
esac
echo "fake gh: unsupported: $*" >&2
exit 2
