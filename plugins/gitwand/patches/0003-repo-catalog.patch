diff --git a/apps/desktop/src/components/RepoCatalogModal.vue b/apps/desktop/src/components/RepoCatalogModal.vue
new file mode 100644
index 0000000..3293d1c
--- /dev/null
+++ b/apps/desktop/src/components/RepoCatalogModal.vue
@@ -0,0 +1,764 @@
+<script setup lang="ts">
+/**
+ * RepoCatalogModal — every repository the user has, in one searchable list:
+ * the ones found under their project folders and the ones their signed-in
+ * forge accounts can see (gh, glab). Local rows open the repository; remote
+ * rows with a local clone open that clone; the others go to CloneModal with
+ * the URL filled in, so the parent folder is still asked every time.
+ *
+ * Rows with a local clone also show their status (branch, ahead/behind,
+ * changes), loaded in batches as they scroll into view, and take part in
+ * the bulk actions: Fetch and Pull (after a confirmation) on the selection or,
+ * without one, on the rows shown; Pull requests on the selection only. The
+ * actions reuse the workspace_*_all commands, which take a list of repos.
+ *
+ * The remote listing is cached by the host and only fetched again with
+ * Refresh; opening the dialog rescans the local folders only.
+ */
+import { computed, nextTick, onBeforeUnmount, onMounted, reactive, ref, watch } from "vue";
+import { useI18n } from "../composables/useI18n";
+import { catalogRows, sourceLabel, type RepoCatalogRow, type RepoCatalogScope } from "../composables/repoCatalogRows";
+import { bulkTargets, StatusQueue, STATUS_BATCH } from "../composables/repoCatalogBulk";
+import { repoCatalog, repoCatalogRefresh, type RepoCatalog } from "../utils/backend-catalog";
+import {
+  openExternalUrl,
+  workspaceFetchAll,
+  workspacePrsAll,
+  workspacePullAll,
+  workspaceStatusAll,
+  type PullRequest,
+  type WorkspaceRepo,
+  type WorkspaceRepoStatus,
+} from "../utils/backend";
+import { formatRelativeAge } from "../utils/relativeTime";
+import BaseModal from "./BaseModal.vue";
+
+const emit = defineEmits<{
+  close: [];
+  open: [path: string];
+  clone: [url: string];
+}>();
+
+const { t } = useI18n();
+
+const catalog = ref<RepoCatalog | null>(null);
+const loading = ref(true);
+const refreshing = ref(false);
+const error = ref<string | null>(null);
+const query = ref("");
+const scope = ref<RepoCatalogScope>("all");
+const searchEl = ref<HTMLInputElement | null>(null);
+const listEl = ref<HTMLElement | null>(null);
+
+const rows = computed(() => (catalog.value ? catalogRows(catalog.value, scope.value, query.value) : []));
+/** Every row with a local clone, whatever the filter: selections are looked up here. */
+const localRows = computed(() => (catalog.value ? catalogRows(catalog.value, "local", "") : []));
+const counts = computed(() => {
+  const c = catalog.value;
+  return {
+    all: c ? catalogRows(c, "all", "").length : 0,
+    local: c?.local.length ?? 0,
+    remote: c?.remote.length ?? 0,
+  };
+});
+const scopes: { value: RepoCatalogScope; label: () => string }[] = [
+  { value: "all", label: () => t("repoCatalog.scopeAll") },
+  { value: "local", label: () => t("repoCatalog.scopeLocal") },
+  { value: "remote", label: () => t("repoCatalog.scopeRemote") },
+];
+
+const fetchedAt = computed(() => {
+  const times = (catalog.value?.sources ?? []).map((s) => s.fetchedAt).filter((x): x is string => x !== null);
+  return times.length > 0 ? times.sort()[times.length - 1]! : null;
+});
+const updatedLabel = computed(() =>
+  fetchedAt.value ? t("repoCatalog.updated", formatRelativeAge(fetchedAt.value, t)) : t("repoCatalog.notUpdated"),
+);
+const notices = computed(() => {
+  const c = catalog.value;
+  if (!c) return [];
+  return [
+    ...c.roots.filter((r) => !r.ok).map((r) => t("repoCatalog.rootMissing", r.root)),
+    ...(c.truncated ? [t("repoCatalog.truncated")] : []),
+    ...c.sources.filter((s) => !s.ok && s.error).map((s) => `${sourceLabel(s)}: ${s.error}`),
+  ];
+});
+
+function message(err: unknown): string {
+  return err instanceof Error ? err.message : String(err);
+}
+
+async function load() {
+  loading.value = true;
+  error.value = null;
+  try {
+    catalog.value = await repoCatalog();
+  } catch (err) {
+    error.value = t("repoCatalog.loadError", message(err));
+  } finally {
+    loading.value = false;
+  }
+}
+
+async function refresh() {
+  if (refreshing.value) return;
+  refreshing.value = true;
+  error.value = null;
+  try {
+    catalog.value = await repoCatalogRefresh();
+  } catch (err) {
+    error.value = t("repoCatalog.loadError", message(err));
+  } finally {
+    refreshing.value = false;
+  }
+}
+
+function pick(row: RepoCatalogRow) {
+  if (row.path) emit("open", row.path);
+  else if (row.cloneUrl) emit("clone", row.cloneUrl);
+}
+
+// ─── Status, loaded for the rows in view ─────────────────────
+const statuses = reactive(new Map<string, WorkspaceRepoStatus>());
+const statusQueue = new StatusQueue(
+  workspaceStatusAll,
+  (list) => list.forEach((s) => statuses.set(s.path, s)),
+  (repos, msg) => repos.forEach((r) => statuses.set(r.path, { path: r.path, name: r.name, branch: "", ahead: 0, behind: 0, has_upstream: false, modified: 0, conflicted: 0, error: msg })),
+);
+
+function statusText(s: WorkspaceRepoStatus): string {
+  if (s.error) return s.error;
+  const parts = [s.branch];
+  if (!s.has_upstream) parts.push(t("repoCatalog.noUpstream"));
+  else if (s.ahead || s.behind) parts.push(`\u2191${s.ahead} \u2193${s.behind}`);
+  if (s.modified) parts.push(t("repoCatalog.changed", s.modified));
+  if (s.conflicted) parts.push(t("repoCatalog.conflicted", s.conflicted));
+  return parts.filter(Boolean).join(" \u00b7 ");
+}
+
+let observer: IntersectionObserver | null = null;
+function observeRows() {
+  observer?.disconnect();
+  if (!listEl.value || typeof IntersectionObserver === "undefined") return;
+  observer = new IntersectionObserver(
+    (entries) => {
+      const wanted: WorkspaceRepo[] = [];
+      for (const e of entries) {
+        const el = e.target as HTMLElement;
+        if (e.isIntersecting && el.dataset.path) wanted.push({ path: el.dataset.path, name: el.dataset.name ?? "" });
+      }
+      if (wanted.length > 0) statusQueue.want(wanted);
+    },
+    { root: listEl.value },
+  );
+  listEl.value.querySelectorAll<HTMLElement>("[data-path]").forEach((el) => observer!.observe(el));
+}
+watch(rows, () => nextTick(observeRows));
+onBeforeUnmount(() => observer?.disconnect());
+
+// ─── Selection and bulk actions ──────────────────────────────
+const selected = reactive(new Set<string>());
+const shownLocal = computed(() => rows.value.filter((r) => r.path !== null));
+const targets = computed(() => bulkTargets(rows.value, localRows.value, selected));
+const busy = ref<null | "status" | "fetch" | "pull" | "prs">(null);
+const progress = ref<{ done: number; total: number } | null>(null);
+const confirmPull = ref<WorkspaceRepo[] | null>(null);
+const prs = reactive(new Map<string, { prs: PullRequest[]; error: string | null }>());
+
+function toggle(path: string) {
+  if (selected.has(path)) selected.delete(path);
+  else selected.add(path);
+}
+function selectShown() {
+  shownLocal.value.forEach((r) => selected.add(r.path!));
+}
+
+/** Runs `step` over the repositories in batches, showing the progress. */
+async function inBatches(kind: NonNullable<typeof busy.value>, repos: WorkspaceRepo[], step: (batch: WorkspaceRepo[]) => Promise<void>) {
+  if (busy.value || repos.length === 0) return;
+  busy.value = kind;
+  error.value = null;
+  progress.value = { done: 0, total: repos.length };
+  try {
+    for (let i = 0; i < repos.length; i += STATUS_BATCH) {
+      const batch = repos.slice(i, i + STATUS_BATCH);
+      await step(batch);
+      progress.value = { done: Math.min(i + STATUS_BATCH, repos.length), total: repos.length };
+    }
+  } catch (err) {
+    error.value = message(err);
+  } finally {
+    busy.value = null;
+    progress.value = null;
+  }
+}
+
+const keepStatuses = (list: WorkspaceRepoStatus[]) => list.forEach((s) => statuses.set(s.path, s));
+function refreshStatus() {
+  const repos = targets.value;
+  void inBatches("status", repos, async (b) => keepStatuses(await workspaceStatusAll(b)));
+}
+function fetchTargets() {
+  void inBatches("fetch", targets.value, async (b) => keepStatuses(await workspaceFetchAll(b)));
+}
+function askPull() {
+  if (targets.value.length > 0) confirmPull.value = targets.value;
+}
+function pullConfirmed() {
+  const repos = confirmPull.value ?? [];
+  confirmPull.value = null;
+  void inBatches("pull", repos, async (b) => keepStatuses(await workspacePullAll(b)));
+}
+function listPrs() {
+  if (selected.size === 0) return;
+  void inBatches("prs", targets.value, async (b) => {
+    for (const r of await workspacePrsAll(b)) prs.set(r.repoPath, { prs: r.prs, error: r.error });
+  });
+}
+
+onMounted(() => {
+  nextTick(() => searchEl.value?.focus());
+  load();
+});
+</script>
+
+<template>
+  <BaseModal size="lg" :title="t('repoCatalog.title')" @close="emit('close')">
+    <template #title-icon>
+      <span class="rc-icon" aria-hidden="true">
+        <svg width="20" height="20" viewBox="0 0 16 16" fill="none">
+          <path d="M2 3.5A1.5 1.5 0 013.5 2h3.586a1.5 1.5 0 011.06.44l.915.914a1 1 0 00.707.293H12.5A1.5 1.5 0 0114 5.147V12.5A1.5 1.5 0 0112.5 14h-9A1.5 1.5 0 012 12.5v-9z" stroke="currentColor" stroke-width="1.2" />
+        </svg>
+      </span>
+    </template>
+
+    <div class="rc-body">
+      <div class="rc-toolbar">
+        <input
+          ref="searchEl"
+          v-model="query"
+          type="search"
+          class="rc-search"
+          :placeholder="t('repoCatalog.searchPlaceholder')"
+          :aria-label="t('repoCatalog.searchPlaceholder')"
+          autocomplete="off"
+          spellcheck="false"
+        />
+        <div class="rc-scopes" role="group" :aria-label="t('repoCatalog.title')">
+          <button
+            v-for="s in scopes"
+            :key="s.value"
+            type="button"
+            class="rc-scope"
+            :class="{ 'rc-scope--active': scope === s.value }"
+            :aria-pressed="scope === s.value"
+            @click="scope = s.value"
+          >
+            {{ s.label() }}
+            <span class="rc-scope-count">{{ counts[s.value] }}</span>
+          </button>
+        </div>
+      </div>
+
+      <div class="rc-status">
+        <span class="rc-updated muted">{{ updatedLabel }}</span>
+        <button type="button" class="rc-refresh" :disabled="refreshing || loading" @click="refresh">
+          <span v-if="refreshing" class="rc-spinner" aria-hidden="true"></span>
+          {{ refreshing ? t("repoCatalog.refreshing") : t("repoCatalog.refresh") }}
+        </button>
+      </div>
+
+      <div v-if="shownLocal.length > 0 || selected.size > 0" class="rc-bulk">
+        <span class="rc-bulk-scope">
+          <template v-if="selected.size > 0">
+            {{ t("repoCatalog.selectedCount", selected.size) }}
+            <button type="button" class="rc-link" @click="selected.clear()">{{ t("repoCatalog.clearSelection") }}</button>
+          </template>
+          <template v-else>
+            {{ t("repoCatalog.shownCount", shownLocal.length) }}
+            <button type="button" class="rc-link" @click="selectShown">{{ t("repoCatalog.selectShown") }}</button>
+          </template>
+        </span>
+        <span class="rc-bulk-actions">
+          <span v-if="progress" class="rc-progress muted" aria-live="polite">
+            <span class="rc-spinner" aria-hidden="true"></span>{{ t("repoCatalog.progress", progress.done, progress.total) }}
+          </span>
+          <button type="button" class="rc-refresh" :disabled="busy !== null || targets.length === 0" @click="refreshStatus">{{ t("repoCatalog.refreshStatus") }}</button>
+          <button type="button" class="rc-refresh" :disabled="busy !== null || targets.length === 0" @click="fetchTargets">{{ t("repoCatalog.fetch") }}</button>
+          <button type="button" class="rc-refresh" :disabled="busy !== null || targets.length === 0" @click="askPull">{{ t("repoCatalog.pull") }}</button>
+          <button
+            type="button"
+            class="rc-refresh"
+            :disabled="busy !== null || selected.size === 0"
+            :title="selected.size === 0 ? t('repoCatalog.prsNeedSelection') : undefined"
+            @click="listPrs"
+          >{{ t("repoCatalog.prs") }}</button>
+        </span>
+      </div>
+
+      <ul v-if="notices.length > 0" class="rc-notices" role="status">
+        <li v-for="n in notices" :key="n">{{ n }}</li>
+      </ul>
+      <p v-if="error" class="rc-error" role="alert">{{ error }}</p>
+
+      <p v-if="loading" class="rc-empty muted">{{ t("repoCatalog.loading") }}</p>
+      <p v-else-if="catalog && rows.length === 0" class="rc-empty muted">
+        {{ query.trim() ? t("repoCatalog.noMatch") : t("repoCatalog.empty") }}
+      </p>
+      <ul v-else-if="catalog" ref="listEl" class="rc-list">
+        <li
+          v-for="row in rows"
+          :key="row.key"
+          class="rc-item"
+          :data-path="row.path ?? undefined"
+          :data-name="row.name"
+        >
+          <span class="rc-check">
+            <input
+              v-if="row.path"
+              type="checkbox"
+              :checked="selected.has(row.path)"
+              :aria-label="t('repoCatalog.selectRepo', row.name)"
+              @change="toggle(row.path)"
+            />
+          </span>
