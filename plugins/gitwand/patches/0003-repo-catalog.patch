--- /dev/null
+++ b/apps/desktop/src/components/__tests__/RepoCatalogModal.test.ts
@@ -0,0 +1,151 @@
+// @vitest-environment jsdom
+/**
+ * The Repositories dialog: remote rows clone through CloneModal, pull only
+ * runs after the confirmation lists the repositories it touches, and pull
+ * requests are listed for the selection only.
+ */
+import { describe, it, expect, vi, afterEach, beforeEach } from "vitest";
+import { createApp, nextTick, type App } from "vue";
+import RepoCatalogModal from "../RepoCatalogModal.vue";
+
+const backend = vi.hoisted(() => ({
+  workspaceStatusAll: vi.fn(async (repos: { path: string; name: string }[]) =>
+    repos.map((r) => ({ path: r.path, name: r.name, branch: "main", ahead: 1, behind: 2, has_upstream: true, modified: 3, conflicted: 0, error: null })),
+  ),
+  workspaceFetchAll: vi.fn(async () => []),
+  workspacePullAll: vi.fn(async () => []),
+  workspacePrsAll: vi.fn(async (repos: { path: string; name: string }[]) =>
+    repos.map((r) => ({ repoPath: r.path, repoName: r.name, prs: [{ number: 7, title: "Fix the thing", url: "https://example.invalid/pr/7" }], error: null })),
+  ),
+  openExternalUrl: vi.fn(async () => {}),
+}));
+vi.mock("../../utils/backend", () => backend);
+
+vi.mock("../../utils/backend-catalog", () => ({
+  repoCatalog: vi.fn(async () => ({
+    local: [
+      { path: "/p/alpha", name: "alpha", remote: null },
+      { path: "/p/beta", name: "beta", remote: null },
+    ],
+    remote: [
+      {
+        id: "github.com/me/gamma",
+        kind: "github",
+        host: "github.com",
+        fullName: "me/gamma",
+        description: null,
+        private: true,
+        archived: false,
+        fork: false,
+        cloneUrl: "git@github.com:me/gamma.git",
+        webUrl: "https://github.com/me/gamma",
+        updatedAt: null,
+        sources: ["github.com/me"],
+        localPath: null,
+      },
+    ],
+    sources: [{ id: "github.com/me", kind: "github", host: "github.com", account: "me", ok: true, error: null, count: 1, fetchedAt: null }],
+    roots: [{ root: "/p", ok: true }],
+    truncated: false,
+    scannedAt: "2026-11-26T10:00:00.000Z",
+  })),
+  repoCatalogRefresh: vi.fn(),
+}));
+
+vi.mock("../../composables/useI18n", () => ({
+  useI18n: () => ({ t: (key: string, ...args: unknown[]) => (args.length ? `${key}:${args.join(",")}` : key) }),
+}));
+
+let app: App | null = null;
+let container: HTMLDivElement | null = null;
+const emitted: { open: string[]; clone: string[] } = { open: [], clone: [] };
+
+beforeEach(() => {
+  emitted.open = [];
+  emitted.clone = [];
+  Object.values(backend).forEach((f) => f.mockClear());
+});
+
+afterEach(() => {
+  app?.unmount();
+  container?.remove();
+  app = null;
+  container = null;
+});
+
+async function settle() {
+  for (let i = 0; i < 6; i++) {
+    await Promise.resolve();
+    await nextTick();
+  }
+}
+
+async function mount() {
+  container = document.createElement("div");
+  document.body.appendChild(container);
+  app = createApp(RepoCatalogModal, {
+    onClose: () => {},
+    onOpen: (p: string) => emitted.open.push(p),
+    onClone: (u: string) => emitted.clone.push(u),
+  });
+  app.mount(container);
+  await settle();
+}
+
+const button = (text: string) => [...document.body.querySelectorAll("button")].find((b) => b.textContent?.trim() === text)!;
+const rowButton = (name: string) => [...document.body.querySelectorAll<HTMLButtonElement>(".rc-row")].find((b) => b.querySelector(".rc-row-name")?.textContent === name)!;
+const checkbox = (name: string) => document.body.querySelector<HTMLInputElement>(`input[aria-label="repoCatalog.selectRepo:${name}"]`)!;
+
+describe("RepoCatalogModal", () => {
+  it("opens a local repository and sends a remote one to the clone dialog", async () => {
+    await mount();
+    rowButton("alpha").click();
+    rowButton("me/gamma").click();
+    expect(emitted).toEqual({ open: ["/p/alpha"], clone: ["git@github.com:me/gamma.git"] });
+  });
+
+  it("pulls only after the confirmation, which lists every repository", async () => {
+    await mount();
+    button("repoCatalog.pull").click();
+    await settle();
+    expect(backend.workspacePullAll).not.toHaveBeenCalled();
+    const list = [...document.body.querySelectorAll(".rc-confirm-list li")].map((li) => li.textContent?.replace(/\s+/g, " ").trim());
+    expect(list).toEqual(["alpha /p/alpha", "beta /p/beta"]);
+    button("repoCatalog.pullConfirm").click();
+    await settle();
+    expect(backend.workspacePullAll).toHaveBeenCalledWith([
+      { path: "/p/alpha", name: "alpha" },
+      { path: "/p/beta", name: "beta" },
+    ]);
+  });
+
+  it("fetches the selection when there is one", async () => {
+    await mount();
+    checkbox("beta").click();
+    await settle();
+    button("repoCatalog.fetch").click();
+    await settle();
+    expect(backend.workspaceFetchAll).toHaveBeenCalledWith([{ path: "/p/beta", name: "beta" }]);
+  });
+
+  it("lists pull requests for the selection only", async () => {
+    await mount();
+    expect(button("repoCatalog.prs").disabled).toBe(true);
+    checkbox("alpha").click();
+    await settle();
+    button("repoCatalog.prs").click();
+    await settle();
+    expect(backend.workspacePrsAll).toHaveBeenCalledWith([{ path: "/p/alpha", name: "alpha" }]);
+    expect(document.body.querySelector(".rc-pr")?.textContent?.trim()).toBe("#7 Fix the thing");
+  });
+
+  it("shows the status of the selection after Refresh status", async () => {
+    await mount();
+    checkbox("alpha").click();
+    await settle();
+    button("repoCatalog.refreshStatus").click();
+    await settle();
+    expect(backend.workspaceStatusAll).toHaveBeenCalledWith([{ path: "/p/alpha", name: "alpha" }]);
+    expect(document.body.querySelector(".rc-row-state")?.textContent?.trim()).toBe("main · ↑1 ↓2 · repoCatalog.changed:3");
+  });
+});
