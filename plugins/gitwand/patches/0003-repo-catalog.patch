diff --git a/apps/desktop/src/composables/repoCatalogBulk.ts b/apps/desktop/src/composables/repoCatalogBulk.ts
new file mode 100644
index 0000000..ae81e56
--- /dev/null
+++ b/apps/desktop/src/composables/repoCatalogBulk.ts
@@ -0,0 +1,70 @@
+// Bulk work in the Repositories dialog: which repositories an action applies
+// to, and a queue that loads their status in batches, each repository once,
+// so opening the dialog never asks for every repository at once.
+import type { WorkspaceRepo, WorkspaceRepoStatus } from "../utils/backend";
+import type { RepoCatalogRow } from "./repoCatalogRows";
+
+export const STATUS_BATCH = 20;
+
+/**
+ * The repositories an action applies to: the selected paths when there is a
+ * selection (hidden by the filter or not), otherwise the visible rows that
+ * have a local clone. Each path once, named after its first row.
+ */
+export function bulkTargets(visible: RepoCatalogRow[], all: RepoCatalogRow[], selected: ReadonlySet<string>): WorkspaceRepo[] {
+  const source = selected.size > 0 ? all.filter((r) => r.path !== null && selected.has(r.path)) : visible.filter((r) => r.path !== null);
+  const seen = new Map<string, WorkspaceRepo>();
+  for (const r of source) if (!seen.has(r.path!)) seen.set(r.path!, { path: r.path!, name: r.name });
+  return [...seen.values()];
+}
+
+export class StatusQueue {
+  private readonly done = new Set<string>();
+  private readonly queued = new Map<string, WorkspaceRepo>();
+  private running: Promise<void> | null = null;
+
+  constructor(
+    private readonly fetch: (repos: WorkspaceRepo[]) => Promise<WorkspaceRepoStatus[]>,
+    private readonly onStatus: (statuses: WorkspaceRepoStatus[]) => void,
+    private readonly onError: (repos: WorkspaceRepo[], message: string) => void,
+    private readonly batch = STATUS_BATCH,
+  ) {}
+
+  /** Loads the status of these repositories unless it is loaded or on its way. */
+  want(repos: WorkspaceRepo[]): void {
+    for (const r of repos) if (!this.done.has(r.path) && !this.queued.has(r.path)) this.queued.set(r.path, r);
+    this.drain();
+  }
+
+  /** Loads the status of these repositories again. */
+  refresh(repos: WorkspaceRepo[]): void {
+    for (const r of repos) this.done.delete(r.path);
+    this.want(repos);
+  }
+
+  /** Resolves once nothing is queued or running. */
+  async idle(): Promise<void> {
+    while (this.running !== null) await this.running;
+  }
+
+  private drain(): void {
+    if (this.running !== null || this.queued.size === 0) return;
+    this.running = (async () => {
+      while (this.queued.size > 0) {
+        const next = [...this.queued.values()].slice(0, this.batch);
+        for (const r of next) {
+          this.queued.delete(r.path);
+          this.done.add(r.path);
+        }
+        try {
+          this.onStatus(await this.fetch(next));
+        } catch (err) {
+          for (const r of next) this.done.delete(r.path);
+          this.onError(next, err instanceof Error ? err.message : String(err));
+        }
+      }
+    })().finally(() => {
+      this.running = null;
+    });
+  }
+}
diff --git a/apps/desktop/src/composables/repoCatalogRows.ts b/apps/desktop/src/composables/repoCatalogRows.ts
new file mode 100644
index 0000000..a7b8c6a
--- /dev/null
+++ b/apps/desktop/src/composables/repoCatalogRows.ts
@@ -0,0 +1,71 @@
+// Rows of the Repositories dialog: pure, so the filtering is testable
+// without the component.
+import type { RepoCatalog, RepoCatalogSource } from "../utils/backend-catalog";
+
+export type RepoCatalogScope = "all" | "local" | "remote";
+
+export interface RepoCatalogRow {
+  key: string;
+  kind: "local" | "remote";
+  name: string;
+  /** Path for a local repository, forge and accounts for a remote one. */
+  detail: string;
+  description: string | null;
+  /** Open this path, or clone `cloneUrl` when null. */
+  path: string | null;
+  cloneUrl: string | null;
+  action: "open" | "clone";
+  private: boolean;
+  archived: boolean;
+  fork: boolean;
+}
+
+const FORGE = { github: "GitHub", gitlab: "GitLab" } as const;
+
+export function sourceLabel(source: Pick<RepoCatalogSource, "kind" | "host" | "account">): string {
+  return `${FORGE[source.kind]} · ${source.account ?? source.host}`;
+}
+
+const byName = (a: RepoCatalogRow, b: RepoCatalogRow) => a.name.localeCompare(b.name, undefined, { sensitivity: "base" });
+
+export function catalogRows(catalog: RepoCatalog, scope: RepoCatalogScope, query: string): RepoCatalogRow[] {
+  const accounts = new Map(catalog.sources.map((s) => [s.id, s]));
+  const local: RepoCatalogRow[] = catalog.local.map((r) => ({
+    key: `local:${r.path}`,
+    kind: "local",
+    name: r.name,
+    detail: r.path,
+    description: null,
+    path: r.path,
+    cloneUrl: null,
+    action: "open",
+    private: false,
+    archived: false,
+    fork: false,
+  }));
+  const remote: RepoCatalogRow[] = catalog.remote
+    .filter((r) => scope === "remote" || r.localPath === null)
+    .map((r) => {
+      const names = r.sources.map((id) => accounts.get(id)?.account ?? accounts.get(id)?.host ?? r.host);
+      return {
+        key: `remote:${r.id}`,
+        kind: "remote",
+        name: r.fullName,
+        detail: `${FORGE[r.kind]} · ${[...new Set(names)].join(", ")}`,
+        description: r.description,
+        path: r.localPath,
+        cloneUrl: r.cloneUrl,
+        action: r.localPath === null ? "clone" : "open",
+        private: r.private,
+        archived: r.archived,
+        fork: r.fork,
+      };
+    });
+  const rows = scope === "local" ? local.sort(byName) : scope === "remote" ? remote.sort(byName) : [...local.sort(byName), ...remote.sort(byName)];
+  const words = query.toLowerCase().split(/\s+/).filter(Boolean);
+  if (words.length === 0) return rows;
+  return rows.filter((row) => {
+    const text = `${row.name} ${row.detail} ${row.description ?? ""} ${row.cloneUrl ?? ""}`.toLowerCase();
+    return words.every((w) => text.includes(w));
+  });
+}
