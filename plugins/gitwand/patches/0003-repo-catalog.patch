diff --git a/apps/desktop/src/utils/backend-catalog.ts b/apps/desktop/src/utils/backend-catalog.ts
new file mode 100644
index 0000000..09acdfd
--- /dev/null
+++ b/apps/desktop/src/utils/backend-catalog.ts
@@ -0,0 +1,62 @@
+// backend-catalog.ts — the repository catalog behind the Repositories dialog:
+// local repositories found under the user's project folders and the remote
+// ones the signed-in forge CLIs (gh, glab) can see. The host answers both
+// commands; the listing is cached there and refreshed on request only.
+
+import { tauriInvoke } from "./backend-core";
+
+export interface RepoCatalogLocal {
+  path: string;
+  name: string;
+  /** "host/owner/name" of its first forge remote, if any. */
+  remote: string | null;
+}
+
+export interface RepoCatalogRemote {
+  /** "host/owner/name", lower case. */
+  id: string;
+  kind: "github" | "gitlab";
+  host: string;
+  fullName: string;
+  description: string | null;
+  private: boolean;
+  archived: boolean;
+  fork: boolean;
+  cloneUrl: string;
+  webUrl: string;
+  updatedAt: string | null;
+  /** Ids of the sources (accounts) that list it. */
+  sources: string[];
+  /** Path of a local clone, if one was found. */
+  localPath: string | null;
+}
+
+export interface RepoCatalogSource {
+  id: string;
+  kind: "github" | "gitlab";
+  host: string;
+  account: string | null;
+  ok: boolean;
+  error: string | null;
+  count: number;
+  fetchedAt: string | null;
+}
+
+export interface RepoCatalog {
+  local: RepoCatalogLocal[];
+  remote: RepoCatalogRemote[];
+  sources: RepoCatalogSource[];
+  roots: { root: string; ok: boolean }[];
+  truncated: boolean;
+  scannedAt: string;
+}
+
+/** The catalog: a fresh local scan and the cached remote listing. */
+export async function repoCatalog(): Promise<RepoCatalog> {
+  return tauriInvoke<RepoCatalog>("repo_catalog", {}, 120_000);
+}
+
+/** Scans again and lists every forge account again. */
+export async function repoCatalogRefresh(): Promise<RepoCatalog> {
+  return tauriInvoke<RepoCatalog>("repo_catalog_refresh", {}, 300_000);
+}
