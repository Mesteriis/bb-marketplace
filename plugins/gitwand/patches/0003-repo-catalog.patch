@@ -0,0 +1,20 @@
+//! Repository catalog commands (`repo_catalog`, `repo_catalog_refresh`).
+//!
+//! The Repositories dialog lists the user's local repositories and the ones
+//! their forge accounts can see. That listing belongs to the host that embeds
+//! GitWand: inside BB the plugin server answers both commands before they
+//! reach Rust. The desktop app has no catalog of its own yet, so here both
+//! commands say so instead of returning an empty list that would look like
+//! "you have no repositories".
+
+const NO_CATALOG: &str = "The repository catalog is not available in this build of GitWand";
+
+#[tauri::command]
+pub(crate) async fn repo_catalog() -> Result<serde_json::Value, String> {
+    Err(NO_CATALOG.to_string())
+}
+
+#[tauri::command]
+pub(crate) async fn repo_catalog_refresh() -> Result<serde_json::Value, String> {
+    Err(NO_CATALOG.to_string())
+}
