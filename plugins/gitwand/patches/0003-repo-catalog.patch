+import { describe, it, expect } from "vitest";
+import { bulkTargets, StatusQueue } from "../repoCatalogBulk";
+import type { RepoCatalogRow } from "../repoCatalogRows";
+import type { WorkspaceRepo, WorkspaceRepoStatus } from "../../utils/backend";
+
+const row = (kind: "local" | "remote", name: string, path: string | null): RepoCatalogRow => ({
+  key: `${kind}:${name}`,
+  kind,
+  name,
+  detail: "",
+  description: null,
+  path,
+  cloneUrl: kind === "remote" ? `https://example.invalid/${name}.git` : null,
+  action: path ? "open" : "clone",
+  private: false,
+  archived: false,
+  fork: false,
+});
+
+const status = (path: string): WorkspaceRepoStatus => ({ path, name: path, branch: "main", ahead: 0, behind: 0, has_upstream: true, modified: 0, conflicted: 0, error: null });
+
+function fakeFetch() {
+  const calls: string[][] = [];
+  let release: (() => void) | null = null;
+  const fetch = async (repos: WorkspaceRepo[]) => {
+    calls.push(repos.map((r) => r.path));
+    return repos.map((r) => status(r.path));
+  };
+  return { calls, fetch, hold: () => new Promise<void>((r) => (release = r)), release: () => release?.() };
+}
+
+const repos = (n: number, from = 0): WorkspaceRepo[] => Array.from({ length: n }, (_, i) => ({ path: `/p/r${from + i}`, name: `r${from + i}` }));
+
+describe("StatusQueue", () => {
+  it("asks for the status in batches and only once per repository", async () => {
+    const f = fakeFetch();
+    const results: string[] = [];
+    const q = new StatusQueue(f.fetch, (s) => results.push(...s.map((x) => x.path)), () => {}, 20);
+    q.want(repos(45));
+    q.want(repos(10));
+    await q.idle();
+    expect(f.calls.map((c) => c.length)).toEqual([20, 20, 5]);
+    expect(results).toHaveLength(45);
+    q.want(repos(45));
+    await q.idle();
+    expect(f.calls).toHaveLength(3);
+  });
+
+  it("asks again for the repositories it is told to refresh", async () => {
+    const f = fakeFetch();
+    const q = new StatusQueue(f.fetch, () => {}, () => {}, 20);
+    q.want(repos(3));
+    await q.idle();
+    q.refresh(repos(2));
+    await q.idle();
+    expect(f.calls).toEqual([["/p/r0", "/p/r1", "/p/r2"], ["/p/r0", "/p/r1"]]);
+  });
+
+  it("does not queue a repository twice while a batch is running", async () => {
+    const calls: string[][] = [];
+    let open!: () => void;
+    const gate = new Promise<void>((r) => (open = r));
+    const q = new StatusQueue(
+      async (rs) => {
+        calls.push(rs.map((r) => r.path));
+        await gate;
+        return rs.map((r) => status(r.path));
+      },
+      () => {},
+      () => {},
+      20,
+    );
+    q.want(repos(2));
+    await Promise.resolve();
+    q.want(repos(3));
+    open();
+    await q.idle();
+    expect(calls).toEqual([["/p/r0", "/p/r1"], ["/p/r2"]]);
+  });
+
+  it("reports a failed batch and lets those repositories be asked again", async () => {
+    let fail = true;
+    let calls = 0;
+    const errors: [string[], string][] = [];
+    const loaded: string[] = [];
+    const q = new StatusQueue(
+      async (rs) => {
+        calls++;
+        if (fail) throw new Error("gitwand-bridge stopped");
+        return rs.map((r) => status(r.path));
+      },
+      (s) => loaded.push(...s.map((x) => x.path)),
+      (rs, message) => errors.push([rs.map((r) => r.path), message]),
+      20,
+    );
+    q.want(repos(2));
+    await q.idle();
+    expect(errors).toEqual([[["/p/r0", "/p/r1"], "gitwand-bridge stopped"]]);
+    fail = false;
+    q.want(repos(2));
+    await q.idle();
+    expect(calls).toBe(2);
+    expect(loaded).toEqual(["/p/r0", "/p/r1"]);
+  });
+});
+
+describe("bulkTargets", () => {
+  const visible = [row("local", "alpha", "/p/alpha"), row("remote", "org/beta", null), row("local", "gamma", "/p/gamma")];
+  const all = [...visible, row("remote", "me/alpha", "/p/alpha"), row("local", "delta", "/p/delta")];
+
+  it("takes the visible repositories that have a local path when nothing is selected", () => {
+    expect(bulkTargets(visible, all, new Set())).toEqual([
+      { path: "/p/alpha", name: "alpha" },
+      { path: "/p/gamma", name: "gamma" },
+    ]);
+  });
+
+  it("takes the selection, also rows the filter hides, each path once", () => {
+    expect(bulkTargets(visible, all, new Set(["/p/delta", "/p/alpha"]))).toEqual([
+      { path: "/p/alpha", name: "alpha" },
+      { path: "/p/delta", name: "delta" },
+    ]);
+  });
+});
