{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "makosh",
  "displayName": "Makosh",
  "description": "Plugins of the Makosh family for BB.",
  "plugins": [
    {
      "id": "makosh-mail",
      "displayName": "Makosh Mail [Experimental]",
      "description": "Reads iCloud, Gmail and other IMAP inboxes on a Mail page and hands a chosen message to an agent. Agent mail tools are off by default.",
      "icon": {
        "url": "./icons/makosh-mail.svg"
      },
      "tags": [
        "email",
        "inbox",
        "imap",
        "icloud",
        "gmail",
        "agent-tools",
        "mentions"
      ],
      "author": {
        "name": "Mesteriis",
        "github": "Mesteriis",
        "url": "https://github.com/Mesteriis"
      },
      "source": {
        "git": {
          "url": "https://github.com/Mesteriis/makosh-bb.git",
          "subdir": "plugins/mail",
          "range": "^0.1.0",
          "tagPrefix": "mail/"
        }
      }
    }
  ]
}
