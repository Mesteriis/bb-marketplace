# The Makosh site and the read-status endpoint behind nginx. An example: put your own public name,
# certificate paths and the address of MAKOSH_BIND in place of makosh.example.org and 127.0.0.1:18760.
server {
 listen 80;
 listen [::]:80;
 server_name makosh.example.org;
 location / { return 301 https://$host$request_uri; }
}
server {
 listen 443 ssl;
 listen [::]:443 ssl;
 server_name makosh.example.org;
 ssl_certificate /etc/nginx/ssl/makosh.example.org/fullchain.cer;
 ssl_certificate_key /etc/nginx/ssl/makosh.example.org/private.key;
 server_tokens off;
 client_max_body_size 1k;
 client_body_timeout 10s;
 access_log /var/log/nginx/makosh_access.log;
 error_log /var/log/nginx/makosh_error.log;
 # Read-status images: who opened a message is not written to the access log.
 location /o/ {
  access_log off;
  error_log /dev/null crit;
  proxy_pass http://127.0.0.1:18760;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Connection "";
  proxy_connect_timeout 3s;
  proxy_read_timeout 10s;
 }
 location / {
  proxy_pass http://127.0.0.1:18760;
  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header Connection "";
  proxy_connect_timeout 3s;
  proxy_read_timeout 15s;
 }
}
